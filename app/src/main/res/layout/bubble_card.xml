<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- collapsed: a small tappable moon chip -->
    <FrameLayout
        android:id="@+id/bubble_collapsed"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:background="@drawable/bubble_chip_bg"
        android:contentDescription="@string/cd_drag">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_moon"
            android:tint="@color/white" />
    </FrameLayout>

    <!-- expanded: the cute verse card -->
    <LinearLayout
        android:id="@+id/bubble_expanded"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_bg"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="18dp">

        <!-- title bar doubles as the drag handle -->
        <LinearLayout
            android:id="@+id/bubble_drag_handle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_drag"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/bubble_reference"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/quicksand_bold"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/lavender_deep"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/bubble_copy"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_copy"
                android:padding="8dp"
                android:src="@drawable/ic_copy"
                android:tint="@color/lavender_deep" />

            <ImageButton
                android:id="@+id/bubble_shuffle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_shuffle"
                android:padding="7dp"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/lavender_deep" />

            <ImageButton
                android:id="@+id/bubble_minimise"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_minimise"
                android:padding="7dp"
                android:src="@drawable/ic_minimise"
                android:tint="@color/ink_faint" />

            <ImageButton
                android:id="@+id/bubble_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/ink_faint" />
        </LinearLayout>

        <TextView
            android:id="@+id/bubble_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/amiri_quran"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:maxLines="6"
            android:ellipsize="end"
            android:textColor="@color/ink"
            android:textDirection="rtl"
            android:textSize="19sp" />

        <View
            android:layout_width="44dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:background="@drawable/divider_soft" />

        <TextView
            android:id="@+id/bubble_english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/quicksand_medium"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="6"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
