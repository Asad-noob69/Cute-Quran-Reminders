<?xml version="1.0" encoding="utf-8"?>
<!-- One swatch in the widget-style picker; the ring marks the chosen one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/chip_ring"
        android:layout_width="86dp"
        android:layout_height="62dp"
        android:background="@drawable/theme_chip_ring_off"
        android:padding="5dp">

        <FrameLayout
            android:id="@+id/chip_swatch"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/chip_sample"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/quicksand_bold"
                android:text="@string/theme_sample"
                android:textSize="16sp" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/chip_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/quicksand_medium"
        android:textColor="@color/ink_faint"
        android:textSize="11sp" />
</LinearLayout>
