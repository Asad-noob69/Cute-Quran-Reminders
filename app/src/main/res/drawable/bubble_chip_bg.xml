<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="5dp" android:right="4dp" android:bottom="3dp">
        <shape android:shape="oval">
            <solid android:color="#33000000" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="@color/blush" android:endColor="@color/lavender" />
            <stroke android:width="2dp" android:color="#88FFFFFF" />
        </shape>
    </item>
</layer-list>
